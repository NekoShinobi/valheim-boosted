{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Build",
      "type": "process",
      "command": "python3",
      "args": [
        "${workspaceFolder}/scripts/dev.py",
        "build"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": "$msCompile",
      "group": {
        "kind": "build",
        "isDefault": true
      }
    },
    {
      "label": "Build and deploy",
      "type": "process",
      "command": "python3",
      "args": [
        "${workspaceFolder}/scripts/dev.py",
        "deploy"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": "$msCompile"
    },
    {
      "label": "Refresh game references",
      "type": "process",
      "command": "python3",
      "args": [
        "${workspaceFolder}/scripts/dev.py",
        "refresh"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": []
    },
    {
      "label": "Decompile game",
      "type": "process",
      "command": "python3",
      "args": [
        "${workspaceFolder}/scripts/dev.py",
        "decompile"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": []
    },
    {
      "label": "Check environment",
      "type": "process",
      "command": "python3",
      "args": [
        "${workspaceFolder}/scripts/dev.py",
        "doctor"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": []
    },
    {
      "label": "Follow game log",
      "type": "process",
      "command": "python3",
      "args": [
        "${workspaceFolder}/scripts/dev.py",
        "logs"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": []
    }
  ]
}
