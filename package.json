{
  "name": "valheim-boosted",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "bun@1.4.0",
  "scripts": {
    "dev": "bun --hot dashboard/server/index.ts",
    "dev:ui": "bun --bun vite --config dashboard/vite.config.ts",
    "build": "bun --bun vite build --config dashboard/vite.config.ts",
    "start": "bun dashboard/server/index.ts",
    "check": "svelte-check --tsconfig dashboard/tsconfig.json && tsc --noEmit -p dashboard/tsconfig.json",
    "test": "bun test dashboard",
    "mod:build": "python3 scripts/dev.py build",
    "mod:deploy": "python3 scripts/dev.py deploy"
  },
  "dependencies": {
    "svelte": "5.57.0",
    "echarts": "6.1.0"
  },
  "devDependencies": {
    "@sveltejs/vite-plugin-svelte": "7.3.0",
    "vite": "8.2.2",
    "svelte-check": "4.7.6",
    "@types/bun": "1.4.2",
    "typescript": "6.0.3"
  }
}
